# =============================================================================
# Application
# =============================================================================

# Runtime Environment — development | staging | production
ENVIRONMENT=development

# Log Verbosity — DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# FastAPI Host And Port
APP_HOST=0.0.0.0
APP_PORT=8000


# =============================================================================
# Groq — STT, LLM, And TTS Provider
# =============================================================================

# Groq Secret API Key — Obtain From console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq Speech-To-Text Model (Whisper) — e.g. whisper-large-v3
GROQ_STT_MODEL=whisper-large-v3

# Groq LLM Model For Agent Reasoning — e.g. openai/gpt-oss-120b
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Groq Text-To-Speech Model — e.g. canopylabs/orpheus-v1-english
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Groq TTS Voice — e.g. autumn (Orpheus English Voice)
GROQ_TTS_VOICE=autumn


# =============================================================================
# LiveKit — Real-Time Voice And WebRTC Infrastructure
# =============================================================================

# LiveKit Server WebSocket URL — wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key — Obtain From Your LiveKit Project Dashboard
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxx

# LiveKit API Secret — Used To Sign Room Tokens And Webhooks
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LiveKit Room Token TTL In Seconds — Default 3600 (One Hour)
LIVEKIT_TOKEN_TTL=3600

# LiveKit Webhook Secret — Used To Verify Incoming Webhook Signatures
LIVEKIT_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# Redis — Ephemeral Conversation Context Store
# =============================================================================

# Redis Connection String — Points To Local Docker Redis By Default
REDIS_URL=redis://localhost:6379

# Redis Database Index — 0 Through 15
REDIS_DB=0

# Conversation State TTL In Seconds — Evicted After Call Ends (Default 1800)
REDIS_TTL=1800


# =============================================================================
# Restaurant Configuration
# =============================================================================

# Unique Identifier For Restaurant A — Matched Against LiveKit Room Metadata
RESTAURANT_A_ID=restaurant-a

# Display Name For Restaurant A — Used In Greeting And Logs
RESTAURANT_A_NAME=The Grand Bistro

# Unique Identifier For Restaurant B — Matched Against LiveKit Room Metadata
RESTAURANT_B_ID=restaurant-b

# Display Name For Restaurant B — Used In Greeting And Logs
RESTAURANT_B_NAME=Spice Garden


# =============================================================================
# Guardrails
# =============================================================================

# Confidence Threshold Below Which Escalation Is Triggered (0.0 — 1.0)
GUARDRAIL_CONFIDENCE_THRESHOLD=0.6

# Enable Or Disable PII Scrubbing — true | false
GUARDRAIL_PII_ENABLED=true

# Enable Or Disable Profanity Filter — true | false
GUARDRAIL_PROFANITY_ENABLED=true
